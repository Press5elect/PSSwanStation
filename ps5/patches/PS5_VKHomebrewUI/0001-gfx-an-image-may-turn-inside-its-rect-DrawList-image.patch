From ea00f4febd38fbaeedc1ba371744d4fc22fd4db1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 18:22:33 +0000
Subject: [PATCH] gfx: an image may turn inside its rect (DrawList::image's
 angle)

A picture turned about its centre, clockwise in radians, with its rect kept
in place: the batch vertex shaders (Vulkan and GL) turn its texture
coordinates the other way about their centre. With the radius at half the
rect a square picture turns inside its circle: a disc's label that spins.
batch.vert.inc compiled with glslang 16.6.0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01K82DTxFUMseW5GoRiRC7kV
---
 src/gfx/draw_list.cpp             |   5 +-
 src/gfx/draw_list.hpp             |   5 +-
 src/gfx/gl_batch.cpp              |  10 +
 src/gfx/vk/shaders/batch.vert     |  12 ++
 src/gfx/vk/shaders/batch.vert.inc | 345 +++++++++++++++++-------------
 5 files changed, 225 insertions(+), 152 deletions(-)

diff --git a/src/gfx/draw_list.cpp b/src/gfx/draw_list.cpp
index 6263fac..6ae4fea 100644
--- a/src/gfx/draw_list.cpp
+++ b/src/gfx/draw_list.cpp
@@ -259,14 +259,15 @@ void DrawList::star(float cx, float cy, float radius, Color fill, float outline)
     set4(i.params, 0.0f, outline * transform_.scale, 0.0f, static_cast<float>(Shape::star));
 }
 
-void DrawList::image(std::uint32_t texture, const Rect &r, const Rect &uv, Color tint, float radius)
+void DrawList::image(std::uint32_t texture, const Rect &r, const Rect &uv, Color tint, float radius,
+                     float angle)
 {
     Instance &i = append(texture);
     const Rect t = apply(r);
     set4(i.rect, t.x, t.y, t.w, t.h);
     set_color(i.color_top, tint);
     set_color(i.color_bottom, tint);
-    set4(i.params, radius * transform_.scale, 0.0f, 0.0f, static_cast<float>(Shape::image));
+    set4(i.params, radius * transform_.scale, angle, 0.0f, static_cast<float>(Shape::image));
     set4(i.extra, uv.x, uv.y, uv.x + uv.w, uv.y + uv.h);
 }
 
diff --git a/src/gfx/draw_list.hpp b/src/gfx/draw_list.hpp
index 1acd3a5..8fd11b9 100644
--- a/src/gfx/draw_list.hpp
+++ b/src/gfx/draw_list.hpp
@@ -159,8 +159,11 @@ class DrawList
     // Five-pointed star centred at (cx, cy); outline > 0 draws only a stroke.
     void star(float cx, float cy, float radius, Color fill, float outline = 0.0f);
     // uv is the texture rectangle (0..1); see gfx::kFullUv and gfx::kCanvasUv.
+    // angle turns the picture inside r about its centre (radians, clockwise):
+    // the rect stays where it is, so with radius at half its size a square
+    // picture turns inside its circle (a record's label, a disc's).
     void image(std::uint32_t texture, const Rect &r, const Rect &uv, Color tint,
-               float radius = 0.0f);
+               float radius = 0.0f, float angle = 0.0f);
     // The same with a tint that blends from top to bottom: reflections and
     // images that fade out need no cover-up rectangle.
     void image_gradient(std::uint32_t texture, const Rect &r, const Rect &uv, Color top,
diff --git a/src/gfx/gl_batch.cpp b/src/gfx/gl_batch.cpp
index 8370786..ad58650 100644
--- a/src/gfx/gl_batch.cpp
+++ b/src/gfx/gl_batch.cpp
@@ -63,6 +63,16 @@ void main()
     v_t = (shape == 0 && a_extra.y > 0.5) ? clamp(local.x / max(size.x, 1e-3), 0.0, 1.0)
                                           : clamp(local.y / max(size.y, 1e-3), 0.0, 1.0);
     v_uv = mix(a_extra.xy, a_extra.zw, corner);
+    if (shape == 3 && a_params.y != 0.0)
+    {
+        vec2 mid = 0.5 * (a_extra.xy + a_extra.zw);
+        vec2 span = max(abs(a_extra.zw - a_extra.xy), vec2(1e-6));
+        vec2 q = (v_uv - mid) / span * size;
+        float c = cos(a_params.y);
+        float s = sin(a_params.y);
+        q = vec2(c * q.x + s * q.y, -s * q.x + c * q.y);
+        v_uv = mid + q / size * span;
+    }
     v_top = a_top;
     v_bottom = a_bottom;
     v_border = a_border;
diff --git a/src/gfx/vk/shaders/batch.vert b/src/gfx/vk/shaders/batch.vert
index 9fcb74e..71f4d0e 100644
--- a/src/gfx/vk/shaders/batch.vert
+++ b/src/gfx/vk/shaders/batch.vert
@@ -64,6 +64,18 @@ void main()
     v_t = (shape == 0 && a_extra.y > 0.5) ? clamp(local.x / max(size.x, 1e-3), 0.0, 1.0)
                                           : clamp(local.y / max(size.y, 1e-3), 0.0, 1.0);
     v_uv = mix(a_extra.xy, a_extra.zw, corner);
+    // An image turned inside its rect (params.y, radians clockwise): the quad
+    // stays, its texture coordinates turn the other way about their centre.
+    if (shape == 3 && a_params.y != 0.0)
+    {
+        vec2 mid = 0.5 * (a_extra.xy + a_extra.zw);
+        vec2 span = max(abs(a_extra.zw - a_extra.xy), vec2(1e-6));
+        vec2 q = (v_uv - mid) / span * size;
+        float c = cos(a_params.y);
+        float s = sin(a_params.y);
+        q = vec2(c * q.x + s * q.y, -s * q.x + c * q.y);
+        v_uv = mid + q / size * span;
+    }
     v_top = a_top;
     v_bottom = a_bottom;
     v_border = a_border;
