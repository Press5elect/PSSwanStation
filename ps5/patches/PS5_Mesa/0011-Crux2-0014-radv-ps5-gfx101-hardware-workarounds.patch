diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c b/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
index e5b6e83fb16..b12f40423c7 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
@@ -211,7 +211,9 @@ radv_ps5_fill_info(struct radeon_info *info, bool compiler_compat_mode, uint32_t
       .gpu_counter_freq = 100000,
       .max_engine_clock = UINT64_C(2230000),
       .min_engine_clock = UINT64_C(500000),
-      .max_memory_clock = UINT64_C(1750000),
+      /* 875 MHz, sixteen transfers a clock (GDDR6 in ac_memory_ops_per_clock): 14 Gbps a pin,
+       * 448 GB/s on the 256-bit bus. */
+      .max_memory_clock = UINT64_C(875000),
       .min_memory_clock = UINT64_C(96000),
       .num_hw_gfx_contexts = 8,
       .ids_flags = 0,
@@ -303,6 +305,51 @@ radv_ps5_fill_info(struct radeon_info *info, bool compiler_compat_mode, uint32_t
  *
  * GFX1013's model differs from GFX10.3 in more than these; the rest is not
  * taken until measured here (the audit lists them). */
+/* GC 10.1.3's hardware bugs, whose workarounds Mesa keeps for gfx_level == GFX10 only:
+ * RADV_PS5_GFX101_WORKAROUNDS=0 leaves them off (on by default), read once. */
+static bool radv_ps5_gfx101_workarounds = true;
+static once_flag radv_ps5_gfx101_once = ONCE_FLAG_INIT;
+
+static void
+radv_ps5_gfx101_configure(void)
+{
+   radv_ps5_gfx101_workarounds = debug_get_bool_option("RADV_PS5_GFX101_WORKAROUNDS", true);
+}
+
+/* The workarounds for GFX10.1's hardware bugs, which upstream applies on gfx_level == GFX10
+ * alone and the ps5-linux amdgpu bring-up gets by running this GPU as GC 10.1.3 under stock
+ * Mesa. Only workarounds: instruction selection, register programming and the features
+ * reported stay GFX10.3's.
+ * - ACO (has_gfx101_hazards): VMEMtoScalarWrite, VcmpxPermlane, VcmpxExecWAR,
+ *   SMEMtoVectorWrite, LdsBranchVmemWAR, NSAToVMEM and NSA-after-writelane waits; the branch
+ *   offset 0x3f fix; NSA at most one dword (5 addresses) and never in a hard clause; no
+ *   negative unaligned scratch offsets with a VGPR address; no s_inst_prefetch; the NGG
+ *   barrier before GS_ALLOC_REQ. ac_compute_late_alloc: LATE_ALLOC_GS at most 64 for NGG and
+ *   CU2-CU3, not CU1, kept from late alloc.
+ * - NGG exports one degenerate triangle when all are culled (has_ngg_fully_culled_bug).
+ * - No TC-compatible HTILE for mipmapped D32S8 stencil (has_htile_stencil_mipmap_bug), a
+ *   dummy index buffer for draws of zero indices (has_zero_index_buffer_bug), and
+ *   DECOMPRESS_ON_Z_PLANES 2 for 4x MSAA depth/stencil with ITERATE_256
+ *   (has_two_planes_iterate256_bug).
+ * has_gfx101_hazards is part of ac_compiler_info, so shaders compiled with and without them
+ * are cached apart. */
+static void
+radv_ps5_take_gc_10_1_3_bugs(struct radeon_info *info, const struct radeon_info *model)
+{
+   call_once(&radv_ps5_gfx101_once, radv_ps5_gfx101_configure);
+   if (!radv_ps5_gfx101_workarounds)
+      return;
+
+   info->compiler_info.has_gfx101_hazards = true;
+   info->compiler_info.has_ngg_fully_culled_bug = model->compiler_info.has_ngg_fully_culled_bug;
+   info->has_htile_stencil_mipmap_bug = model->has_htile_stencil_mipmap_bug;
+   info->has_zero_index_buffer_bug = model->has_zero_index_buffer_bug;
+   info->has_two_planes_iterate256_bug = model->has_two_planes_iterate256_bug;
+
+   assert(info->compiler_info.has_ngg_fully_culled_bug && info->has_htile_stencil_mipmap_bug &&
+          info->has_zero_index_buffer_bug && info->has_two_planes_iterate256_bug);
+}
+
 static void
 radv_ps5_take_gc_10_1_3_traits(struct radeon_info *info, bool compiler_compat_mode)
 {
@@ -325,6 +372,8 @@ radv_ps5_take_gc_10_1_3_traits(struct radeon_info *info, bool compiler_compat_mo
           !info->compiler_info.has_ngg_per_prim_params && !info->has_ps_strict_vertex_order && !info->has_vrs &&
           !info->rbplus_allowed && !info->has_rgb9e5_color_target && info->has_htile_tc_z_clear_bug_without_stencil &&
           info->has_htile_tc_z_clear_bug_with_stencil && info->chip_external_rev == RADV_PS5_GFX1013_REV);
+
+   radv_ps5_take_gc_10_1_3_bugs(info, &model);
 }
 
 static void
@@ -590,6 +639,8 @@ radv_ps5_winsys_create(const struct radeon_info *info, struct radeon_winsys **wi
       return VK_ERROR_OUT_OF_HOST_MEMORY;
    memcpy(&ws->info, info, sizeof(ws->info));
    ws->queue = queue;
+   fprintf(stderr, "radv/ps5: GFX10.1 hardware workarounds %s (RADV_PS5_GFX101_WORKAROUNDS)\n",
+           info->compiler_info.has_gfx101_hazards ? "on" : "off");
 
    ws->base.destroy = radv_ps5_winsys_destroy;
    ws->base.query_value = radv_ps5_winsys_query_value;
