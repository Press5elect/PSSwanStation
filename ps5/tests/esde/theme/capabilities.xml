<!-- PSSwanStation's ES-DE theme reader test: a theme written for the test (GPL-3.0-or-later, Press5elect). -->
<themeCapabilities>
   <themeName>Parser Test</themeName>
   <aspectRatio>16:9</aspectRatio>
   <aspectRatio>4:3</aspectRatio>
   <aspectRatio>5:3_vertical</aspectRatio>
   <fontSize>small</fontSize>
   <fontSize>medium</fontSize>
   <language>en_US</language>
   <language>de_DE</language>
   <colorScheme name="dark"><label>Dark</label></colorScheme>
   <colorScheme name="light"><label language="de_DE">Hell</label><label language="en_US">Light</label></colorScheme>
   <variant name="list">
      <label>List &amp; Mix</label>
      <selectable>true</selectable>
      <override>
         <trigger>noMedia</trigger>
         <mediaType>miximage,screenshot</mediaType>
         <useVariant>plain</useVariant>
      </override>
   </variant>
   <variant name="grid"><label>Grid</label></variant>
   <variant name="plain"><label>Plain</label><selectable>false</selectable></variant>
</themeCapabilities>
